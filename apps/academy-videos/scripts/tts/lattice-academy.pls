<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0"
    xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
        http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
    alphabet="ipa" xml:lang="en-US">
  <!--
    generate-tts.mjs posts via add-from-rules (not add-from-file).
    IPA only — CMU for contest* never landed right; IPA fixed orthogonal.
    Verb stress on contest*: con-TEST (ˈ on tɛst), first vowel ɑ not ə
    (ə was voiced as "ken"). Phoneme rules need eleven_flash_v2 or eleven_v3.
  -->
  <lexeme>
    <grapheme>orthogonal</grapheme>
    <phoneme>ɔɹˈθɑɡənəl</phoneme>
  </lexeme>
  <lexeme>
    <grapheme>Orthogonal</grapheme>
    <phoneme>ɔɹˈθɑɡənəl</phoneme>
  </lexeme>
  <lexeme>
    <grapheme>orthogonally</grapheme>
    <phoneme>ɔɹˈθɑɡənəli</phoneme>
  </lexeme>
  <lexeme>
    <grapheme>Orthogonally</grapheme>
    <phoneme>ɔɹˈθɑɡənəli</phoneme>
  </lexeme>
  <lexeme>
    <grapheme>contest</grapheme>
    <phoneme>kɑnˈtɛst</phoneme>
  </lexeme>
  <lexeme>
    <grapheme>Contest</grapheme>
    <phoneme>kɑnˈtɛst</phoneme>
  </lexeme>
  <lexeme>
    <grapheme>contests</grapheme>
    <phoneme>kɑnˈtɛsts</phoneme>
  </lexeme>
  <lexeme>
    <grapheme>Contests</grapheme>
    <phoneme>kɑnˈtɛsts</phoneme>
  </lexeme>
  <lexeme>
    <grapheme>contesting</grapheme>
    <phoneme>kɑnˈtɛstɪŋ</phoneme>
  </lexeme>
  <lexeme>
    <grapheme>Contesting</grapheme>
    <phoneme>kɑnˈtɛstɪŋ</phoneme>
  </lexeme>
  <lexeme>
    <grapheme>contested</grapheme>
    <phoneme>kɑnˈtɛstɪd</phoneme>
  </lexeme>
  <lexeme>
    <grapheme>Contested</grapheme>
    <phoneme>kɑnˈtɛstɪd</phoneme>
  </lexeme>
  <!-- Rip / tare — not the crying homograph. Alias is more reliable than
       IPA for this pair (phoneme rules still often pick /tɪɹ/). -->
  <lexeme>
    <grapheme>tear</grapheme>
    <alias>tare</alias>
  </lexeme>
  <lexeme>
    <grapheme>Tear</grapheme>
    <alias>Tare</alias>
  </lexeme>
  <lexeme>
    <grapheme>tears</grapheme>
    <alias>tares</alias>
  </lexeme>
  <lexeme>
    <grapheme>Tears</grapheme>
    <alias>Tares</alias>
  </lexeme>
  <!-- One-word stress so TTS does not split "Target, Lock". -->
  <lexeme>
    <grapheme>Target Lock</grapheme>
    <alias>Targetlock</alias>
  </lexeme>
  <lexeme>
    <grapheme>target lock</grapheme>
    <alias>targetlock</alias>
  </lexeme>
  <lexeme>
    <grapheme>Target-Lock</grapheme>
    <alias>Targetlock</alias>
  </lexeme>
  <lexeme>
    <grapheme>target-lock</grapheme>
    <alias>targetlock</alias>
  </lexeme>
</lexicon>
